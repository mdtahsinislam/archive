# Show values on bars
for bars in [bars1, bars2, bars3]:
    for bar in bars:
        yval = bar.get_height()
        plt.text(
            bar.get_x() + bar.get_width()/2,
            yval,
            f'{yval:.2f}',
            ha='center',
            va='bottom',
            fontsize=9
        )

# Legend
plt.legend()

# Show graph
plt.show()
